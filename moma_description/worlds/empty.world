<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!-- 插入一个地面平面 -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 插入一个太阳光源 -->
    <include>
      <uri>model://sun</uri>
    </include>


    <!-- 定义环境中的物理属性 -->
    <physics type="ode">
      <gravity>0 0 -9.8</gravity>
    </physics>
  </world>
</sdf>